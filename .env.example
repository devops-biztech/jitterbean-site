# Wholesale inquiry form — the only server-side dependency on the site.
# Without these the form fails loudly in production and tells the visitor to
# email the office directly. In `astro dev` it logs the submission instead.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# The verified sender. Must be on a domain verified in Resend, e.g.
# "Jitter Bean Website <website@jitterbeancoffee.com>"
WHOLESALE_FROM=

# Where inquiries land. Defaults to administrator@jitterbeancoffee.com.
WHOLESALE_TO=administrator@jitterbeancoffee.com
